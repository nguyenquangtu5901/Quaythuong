    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function () {
          // =========================================================================
          // 1. CẤU HÌNH ENDPOINT API .NET 8 (Bạn chỉ cần sửa URL tại đây)
          // =========================================================================
          const API_CONFIG = {
            useBackendApi: false, // Đổi thành true khi đã viết xong API ở .NET 8
            getParticipantsUrl: '/api/LuckyDraw/GetParticipants', // GET: trả về [{ code, name, dept }]
            getWinnersUrl: '/api/LuckyDraw/GetWinners',           // GET: trả về [{ code, name, dept, prizeId, prizeName }]
            saveWinnerUrl: '/api/LuckyDraw/SaveWinner',           // POST: body { code, name, dept, prizeId, prizeName }
            resetWinnersUrl: '/api/LuckyDraw/ResetWinners'        // POST: reset toàn bộ kết quả dưới DB/Excel
          };

          // =========================================================================
          // 2. KHỞI TẠO STATE & DỮ LIỆU MẪU (KHI CHƯA BẬT API BACKEND)
          // =========================================================================
          let prizes = [
            { id: 'kk', name: 'Giải khuyến khích', total: 5 },
            { id: 'g4', name: 'Giải tư', total: 4 },
            { id: 'g3', name: 'Giải ba', total: 3 },
            { id: 'g2', name: 'Giải nhì', total: 2 },
            { id: 'g1', name: 'Giải nhất', total: 1 },
            { id: 'db', name: 'Giải đặc biệt', total: 1 }
          ];

          let currentPrizeIndex = 5; // Mặc định: Giải đặc biệt
          let isSpinning = false;
          let soundEnabled = true;
          let lastWinner = null;

          // Dữ liệu mẫu đúng chuẩn cấu trúc sheet nhanvien của bạn
          let participants = [
            { code: 'VN000032', name: 'Tô Văn Thọ', dept: 'Phòng Tổng Vụ' },
            { code: 'VN000034', name: 'Bùi Văn Hiệp', dept: 'Bộ phận R&D' },
            { code: 'VN000035', name: 'Nguyễn Văn Đang', dept: 'Bộ Phận Gia Công' },
            { code: 'VN000043', name: 'Nguyễn Ngọc Sơn', dept: 'Bộ Phận Gia Công' },
            { code: 'VN000061', name: 'Đặng Hồng Phúc', dept: 'Phòng Tổng Vụ' },
            { code: 'VN000064', name: 'Nguyễn Văn Hoàng', dept: 'Bộ phận Thiết Bị' },
            { code: 'VN000065', name: 'Nguyễn Thị Kim Oanh', dept: 'Bộ phận KHSX' },
            { code: 'VN000068', name: 'Phí Quang Hồng', dept: 'Bộ Phận Gia Công' }
          ];

          let winners = { kk: [], g4: [], g3: [], g2: [], g1: [], db: [] };
          let deletedWinnersHistory = [];

          // Phân trang & Tìm kiếm người tham dự
          let currentPage = 1;
          let pageSize = 10;
          let searchQuery = '';
          let selectedCodes = new Set();
          let currentResultTab = 'active';

          // =========================================================================
          // 3. HÀM GỌI API .NET 8 BẰNG JQUERY AJAX
          // =========================================================================
          function loadDataFromDotNetApi() {
            if (!API_CONFIG.useBackendApi) {
              syncParticipantsViews();
              updateMainUI();
              return;
            }

            $('#totalPlayersBadge').text('Đang tải...');

            // Gọi song song danh sách nhân viên và danh sách đã trúng giải
            $.when(
              $.getJSON(API_CONFIG.getParticipantsUrl),
              $.getJSON(API_CONFIG.getWinnersUrl)
            ).done(function (resParticipants, resWinners) {
              participants = resParticipants[0] || [];

              // Gom nhóm danh sách trúng giải theo prizeId
              Object.keys(winners).forEach(k => winners[k] = []);
              const savedWinners = resWinners[0] || [];
              savedWinners.forEach(w => {
                if (winners[w.prizeId]) {
                  winners[w.prizeId].push(w);
                }
              });
              if (savedWinners.length > 0) {
                lastWinner = savedWinners[savedWinners.length - 1];
              }

              syncParticipantsViews();
              updateMainUI();
            }).fail(function (xhr) {
              console.error('Lỗi tải dữ liệu từ .NET 8:', xhr);
              alert('Không thể kết nối API .NET 8. Đang sử dụng dữ liệu cục bộ.');
              syncParticipantsViews();
              updateMainUI();
            });
          }

          function postWinnerToDotNetApi(winnerObj) {
            if (!API_CONFIG.useBackendApi) return;
            $.ajax({
              url: API_CONFIG.saveWinnerUrl,
              type: 'POST',
              contentType: 'application/json',
              data: JSON.stringify(winnerObj),
              error: function (err) {
                console.error('Lỗi lưu kết quả về .NET 8:', err);
              }
            });
          }

          // =========================================================================
          // 4. CẬP NHẬT GIAO DIỆN CHÍNH & BẢNG TRÚNG GIẢI
          // =========================================================================
          function updateMainUI() {
            const currentPrize = prizes[currentPrizeIndex];
            const prizeWinners = winners[currentPrize.id] || [];

            $('#currentPrizeTitle').text(currentPrize.name);
            $('#prizeMedalBadge').text(currentPrize.total);
            $('#totalPlayersBadge').text(participants.length);
            $('#spinStatusText').text(`Đã quay ${prizeWinners.length}/${currentPrize.total} người trúng giải này`);

            const $spinBtn = $('#spinBtn');
            if (prizeWinners.length >= currentPrize.total) {
              $spinBtn.text('ĐÃ ĐỦ GIẢI').prop('disabled', true);
            } else {
              $spinBtn.text(prizeWinners.length > 0 ? 'QUAY TIẾP' : 'QUAY SỐ').prop('disabled', false);
            }

            // Render Tabs
            const tabsHtml = prizes.map((p, idx) => `
              <button class="prize-tab-item ${idx === currentPrizeIndex ? 'active' : ''}" data-index="${idx}">
                ${p.name}
              </button>
            `).join('');
            $('#prizeTabsContainer').html(tabsHtml);

            // Render Bảng trúng giải
            const $tbody = $('#winnersTableBody');
            if (prizeWinners.length === 0) {
              $tbody.html(`<tr><td colspan="4" class="text-white-50 py-4 fst-italic">Chưa có dữ liệu trúng thưởng cho ${currentPrize.name}</td></tr>`);
            } else {
              const rowsHtml = prizeWinners.map((w, idx) => `
                <tr>
                  <td>${idx + 1}</td>
                  <td class="fw-bold text-warning">${w.code}</td>
                  <td class="fw-semibold">${w.name}</td>
                  <td>${w.dept}</td>
                </tr>
              `).join('');
              $tbody.html(rowsHtml);
            }
          }

          function resetSlotsDisplay() {
            $('.slot-box').text('?').removeClass('spinning locked');
          }

          // Sự kiện chuyển giải
          $('#btnPrevPrize').on('click', function () {
            if (isSpinning) return;
            currentPrizeIndex = (currentPrizeIndex - 1 + prizes.length) % prizes.length;
            resetSlotsDisplay();
            updateMainUI();
          });

          $('#btnNextPrize').on('click', function () {
            if (isSpinning) return;
            currentPrizeIndex = (currentPrizeIndex + 1) % prizes.length;
            resetSlotsDisplay();
            updateMainUI();
          });

          $(document).on('click', '.prize-tab-item', function () {
            if (isSpinning) return;
            currentPrizeIndex = parseInt($(this).data('index'));
            resetSlotsDisplay();
            updateMainUI();
          });

          // =========================================================================
          // 5. LOGIC QUAY SỐ 8 Ô KÝ TỰ
          // =========================================================================
          $('#spinBtn').on('click', function () {
            if (isSpinning) return;

            const currentPrize = prizes[currentPrizeIndex];
            if (winners[currentPrize.id].length >= currentPrize.total) {
              return alert('Giải thưởng này đã quay đủ số lượng!');
            }

            const allWonCodes = new Set(Object.values(winners).flat().map(w => w.code));
            const availablePool = participants.filter(p => !allWonCodes.has(p.code));

            if (availablePool.length === 0) {
              return alert('Đã hết người tham dự hợp lệ trong danh sách!');
            }

            const chosenWinner = availablePool[Math.floor(Math.random() * availablePool.length)];
            const targetCode = chosenWinner.code.padEnd(8, ' ').slice(0, 8).toUpperCase();

            isSpinning = true;
            $('#spinBtn').prop('disabled', true);

            const $boxes = $('.slot-box');
            const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';

            $boxes.each(function (idx) {
              const $box = $(this);
              $box.removeClass('locked').addClass('spinning');

              const intervalId = setInterval(() => {
                $box.text(chars[Math.floor(Math.random() * chars.length)]);
                if (idx === 0) playTickSound();
              }, 60);

              setTimeout(() => {
                clearInterval(intervalId);
                $box.text(targetCode[idx]).removeClass('spinning').addClass('locked');
                playLockSound();

                if (idx === $boxes.length - 1) {
                  finishSpin(chosenWinner);
                }
              }, 1100 + idx * 380);
            });
          });

          function finishSpin(winnerObj) {
            isSpinning = false;
            const currentPrize = prizes[currentPrizeIndex];
            const fullWinnerRecord = { ...winnerObj, prizeId: currentPrize.id, prizeName: currentPrize.name };

            winners[currentPrize.id].push(winnerObj);
            lastWinner = fullWinnerRecord;

            updateMainUI();
            playWinSound();
            launchConfetti();
            postWinnerToDotNetApi(fullWinnerRecord);

            setTimeout(() => openCelebrationOverlay(fullWinnerRecord), 400);
          }

          // =========================================================================
          // 6. MÀN HÌNH VINH DANH TOÀN MÀN HÌNH (KẾT QUẢ VỪA QUAY)
          // =========================================================================
          function openCelebrationOverlay(data) {
            $('#celebWinnerCode').text(data.code);
            $('#celebWinnerName').text(data.name);
            $('#celebWinnerDept').text(data.dept);
            $('#celebPrizeName').text(data.prizeName);
            $('#winnerCelebrationOverlay').addClass('show');
          }

          $('#btnCloseCelebOverlay').on('click', function () {
            $('#winnerCelebrationOverlay').removeClass('show');
          });

          $('#btnAnnounceLast').on('click', function () {
            if (lastWinner) {
              openCelebrationOverlay(lastWinner);
            } else {
              // Hiển thị mẫu nếu chưa có lượt quay nào
              openCelebrationOverlay({
                code: 'VN000032',
                name: 'Tô Văn Thọ',
                dept: 'Phòng Tổng Vụ',
                prizeName: 'Giải đặc biệt'
              });
            }
          });

          // =========================================================================
          // 7. QUẢN LÝ DANH SÁCH NGƯỜI THAM DỰ (TÌM KIẾM, THÊM, SỬA, XÓA, PHÂN TRANG)
          // =========================================================================
          function syncParticipantsViews() {
            const text = participants.map(p => `${p.code} | ${p.name} | ${p.dept}`).join('\n');
            $('#participantsInput').val(text);
            renderParticipantsTable();
          }

          function renderParticipantsTable() {
            const filtered = participants.filter(p =>
              p.code.toLowerCase().includes(searchQuery) ||
              p.name.toLowerCase().includes(searchQuery) ||
              p.dept.toLowerCase().includes(searchQuery)
            );

            const totalItems = filtered.length;
            const totalPages = Math.max(1, Math.ceil(totalItems / pageSize));
            if (currentPage > totalPages) currentPage = totalPages;

            const startIdx = (currentPage - 1) * pageSize;
            const endIdx = Math.min(startIdx + pageSize, totalItems);
            const pageData = filtered.slice(startIdx, endIdx);

            $('#modalTotalCount').text(participants.length);
            $('#footerTotalText').text(totalItems);
            $('#pageRangeText').text(totalItems === 0 ? '0-0 / 0' : `${startIdx + 1}-${endIdx} / ${totalItems}`);

            const $tbody = $('#participantsTableBody');
            if (pageData.length === 0) {
              $tbody.html('<tr><td colspan="5" class="text-center text-secondary py-4">Không tìm thấy dữ liệu người tham dự</td></tr>');
            } else {
              $tbody.html(pageData.map(p => `
                <tr>
                  <td><input type="checkbox" class="form-check-input row-checkbox" data-code="${p.code}" ${selectedCodes.has(p.code) ? 'checked' : ''}></td>
                  <td class="fw-semibold" style="color: #c4b5fd;">${p.code}</td>
                  <td class="fw-bold text-white">${p.name}</td>
                  <td class="text-secondary">${p.dept}</td>
                  <td style="text-align: right;">
                    <button class="action-icon-btn btn-edit-person me-1" data-code="${p.code}" title="Sửa"><i class="fa-solid fa-pen" style="font-size: 0.75rem;"></i></button>
                    <button class="action-icon-btn delete btn-delete-person" data-code="${p.code}" title="Xóa"><i class="fa-solid fa-trash-can" style="font-size: 0.75rem;"></i></button>
                  </td>
                </tr>
              `).join(''));
            }

            // Render phân trang
            let pageHtml = `<button class="page-btn" data-page="${currentPage - 1}" ${currentPage === 1 ? 'disabled' : ''}><i class="fa-solid fa-chevron-left"></i></button>`;
            for (let i = 1; i <= totalPages; i++) {
              pageHtml += `<button class="page-btn ${i === currentPage ? 'active' : ''}" data-page="${i}">${i}</button>`;
            }
            pageHtml += `<button class="page-btn" data-page="${currentPage + 1}" ${currentPage === totalPages ? 'disabled' : ''}><i class="fa-solid fa-chevron-right"></i></button>`;
            $('#paginationControls').html(pageHtml);
          }

          $(document).on('click', '.page-btn:not(:disabled)', function () {
            currentPage = parseInt($(this).data('page'));
            renderParticipantsTable();
          });

          $('#pageSizeSelect').on('change', function () {
            pageSize = parseInt($(this).val()) || 10;
            currentPage = 1;
            renderParticipantsTable();
          });

          $('#participantSearchInput').on('input', function () {
            searchQuery = $(this).val().trim().toLowerCase();
            currentPage = 1;
            renderParticipantsTable();
          });

          $('#btnShowSingleBox').on('click', () => { $('#quickAddSingleBox').removeClass('d-none'); $('#quickImportBox').addClass('d-none'); });
          $('#btnShowImportBox').on('click', () => { $('#quickImportBox').removeClass('d-none'); $('#quickAddSingleBox').addClass('d-none'); });
          $('.btn-close-quick-box').on('click', () => { $('#quickAddSingleBox, #quickImportBox').addClass('d-none'); });

          $('#btnSaveSingleParticipant').on('click', function () {
            const code = $('#newCodeInput').val().trim().toUpperCase();
            const name = $('#newNameInput').val().trim();
            const dept = $('#newDeptInput').val().trim() || 'Khách mời';
            if (!code || !name) return alert('Vui lòng nhập Mã số và Họ tên!');
            if (participants.some(p => p.code === code)) return alert('Mã số này đã tồn tại!');

            participants.unshift({ code, name, dept });
            $('#newCodeInput, #newNameInput, #newDeptInput').val('');
            $('#quickAddSingleBox').addClass('d-none');
            syncParticipantsViews();
            updateMainUI();
          });

          $('#btnSaveBulkParticipants').on('click', function () {
            const raw = $('#participantsInput').val().trim();
            if (!raw) return alert('Danh sách không được để trống!');
            participants = raw.split('\n').map(line => {
              const parts = line.split('|').map(s => s.trim());
              return { code: (parts[0] || '').toUpperCase(), name: parts[1] || 'Khách mời', dept: parts[2] || 'Phòng ban' };
            }).filter(x => x.code);

            $('#quickImportBox').addClass('d-none');
            renderParticipantsTable();
            updateMainUI();
          });

          $(document).on('click', '.btn-edit-person', function () {
            const code = $(this).data('code');
            const person = participants.find(p => p.code === code);
            if (!person) return;
            const newName = prompt('Nhập họ tên mới:', person.name);
            if (newName === null) return;
            const newDept = prompt('Nhập bộ phận mới:', person.dept);
            if (newDept === null) return;

            person.name = newName.trim() || person.name;
            person.dept = newDept.trim() || person.dept;
            syncParticipantsViews();
          });

          $(document).on('click', '.btn-delete-person', function () {
            const code = $(this).data('code');
            if (!confirm(`Xóa người tham dự mã ${code}?`)) return;
            participants = participants.filter(p => p.code !== code);
            selectedCodes.delete(code);
            syncParticipantsViews();
            updateMainUI();
          });

          $(document).on('change', '.row-checkbox', function () {
            const code = $(this).data('code');
            if (this.checked) selectedCodes.add(code);
            else selectedCodes.delete(code);
          });

          $('#selectAllCheckbox').on('change', function () {
            const checked = this.checked;
            participants.forEach(p => checked ? selectedCodes.add(p.code) : selectedCodes.delete(p.code));
            $('.row-checkbox').prop('checked', checked);
          });

          $('#btnDeleteSelected').on('click', function () {
            if (selectedCodes.size === 0) return alert('Vui lòng chọn ít nhất 1 dòng!');
            if (!confirm(`Xóa ${selectedCodes.size} người tham dự đã chọn?`)) return;
            participants = participants.filter(p => !selectedCodes.has(p.code));
            selectedCodes.clear();
            $('#selectAllCheckbox').prop('checked', false);
            syncParticipantsViews();
            updateMainUI();
          });

          // =========================================================================
          // 8. CẤU HÌNH GIẢI THƯỞNG
          // =========================================================================
          function renderPrizeConfigModal() {
            const html = prizes.map((p, idx) => `
              <div class="row g-2 mb-2 align-items-center">
                <div class="col-8"><input type="text" class="form-control form-control-sm search-input-dark ps-2 prize-name-input" data-idx="${idx}" value="${p.name}"></div>
                <div class="col-4"><input type="text" disable class="form-control form-control-sm search-input-dark ps-2 text-center prize-total-input" data-idx="${idx}" value="${p.total}" min="1"></div>
              </div>
            `).join('');
            $('#prizeConfigBody').html(html);
          }
          renderPrizeConfigModal();

          $('#btnSavePrizeConfig').on('click', function () {
            $('.prize-name-input').each(function () {
              const idx = $(this).data('idx');
              prizes[idx].name = $(this).val().trim() || prizes[idx].name;
            });
            $('.prize-total-input').each(function () {
              const idx = $(this).data('idx');
              prizes[idx].total = parseInt($(this).val()) || 1;
            });
            updateMainUI();
            bootstrap.Modal.getInstance(document.getElementById('prizeConfigModal')).hide();
          });

          // =========================================================================
          // 9. MODAL KẾT QUẢ TỔNG
          // =========================================================================
          function getFlattenedWinners() {
            let list = [];
            prizes.forEach(p => {
              (winners[p.id] || []).forEach(w => list.push({ ...w, prizeId: p.id, prizeName: p.name }));
            });
            return list;
          }

          $('#btnOpenAllWinners').on('click', function () {
            const filterHtml = '<option value="ALL">Tất cả giải</option>' + prizes.map(p => `<option value="${p.id}">${p.name}</option>`).join('');
            $('#resultPrizeFilter').html(filterHtml);
            currentResultTab = 'active';
            $('.result-tab-btn').removeClass('active').filter('[data-tab="active"]').addClass('active');
            renderAllWinnersTable();
            new bootstrap.Modal(document.getElementById('allWinnersModal')).show();
          });

          $('.result-tab-btn').on('click', function () {
            currentResultTab = $(this).data('tab');
            $('.result-tab-btn').removeClass('active');
            $(this).addClass('active');
            renderAllWinnersTable();
          });

          $('#resultSearchInput, #resultPrizeFilter').on('input change', renderAllWinnersTable);

          function renderAllWinnersTable() {
            const kw = $('#resultSearchInput').val().trim().toLowerCase();
            const pFilter = $('#resultPrizeFilter').val();
            const activeList = getFlattenedWinners();
            const sourceList = currentResultTab === 'active' ? activeList : deletedWinnersHistory;

            $('#totalWinnersSummaryText').html(`Tổng cộng: <strong class="text-white">${activeList.length} người trúng</strong> trong <strong class="text-white">${prizes.length} giải</strong>`);

            const filtered = sourceList.filter(item => {
              const matchKw = item.name.toLowerCase().includes(kw) || item.code.toLowerCase().includes(kw) || item.dept.toLowerCase().includes(kw);
              const matchP = pFilter === 'ALL' || item.prizeId === pFilter;
              return matchKw && matchP;
            });

            const $tbody = $('#allWinnersTableBody');
            if (filtered.length === 0) {
              $tbody.html('<tr><td colspan="5" class="text-center text-secondary py-5">Không có dữ liệu kết quả phù hợp</td></tr>');
              return;
            }

            $tbody.html(filtered.map((item, idx) => `
              <tr>
                <td style="text-align: center;"><span class="stt-badge-purple">${idx + 1}</span></td>
                <td class="fw-bold text-white">${item.name}</td>
                <td><span class="code-pill-gold">${item.code}</span></td>
                <td class="text-secondary">${item.dept}</td>
                <td><span class="prize-pill-cyan"><i class="fa-solid fa-trophy" style="font-size: 0.72rem;"></i> ${item.prizeName}</span></td>
              </tr>
            `).join(''));
          }

          $('#btnResetAllResults').on('click', function () {
            if (!confirm('Chuyển toàn bộ kết quả hiện tại sang mục "Kết quả đã xóa" và reset lượt quay?')) return;
            deletedWinnersHistory = [...deletedWinnersHistory, ...getFlattenedWinners()];
            Object.keys(winners).forEach(k => winners[k] = []);
            lastWinner = null;

            if (API_CONFIG.useBackendApi) {
              $.post(API_CONFIG.resetWinnersUrl);
            }

            resetSlotsDisplay();
            updateMainUI();
            renderAllWinnersTable();
          });

          // =========================================================================
          // 10. TIỆN ÍCH: XUẤT CSV, ÂM THANH, PHÁO HOA, FULLSCREEN
          // =========================================================================
          $('#btnExportCSVMain, #btnExportCSVModal').on('click', function () {
            let csv = '\uFEFFGiải thưởng,STT,Mã trúng thưởng,Họ và tên,Bộ phận\n';
            prizes.forEach(p => {
              winners[p.id].forEach((w, idx) => {
                csv += `"${p.name}",${idx + 1},"${w.code}","${w.name}","${w.dept}"\n`;
              });
            });
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'Ket_Qua_Quay_So.csv';
            link.click();
          });

          $('#btnNavbarReload').on('click', function () {
            if (API_CONFIG.useBackendApi) {
              loadDataFromDotNetApi();
            } else {
              if (!confirm('Làm mới toàn bộ lượt quay hiện tại?')) return;
              Object.keys(winners).forEach(k => winners[k] = []);
              lastWinner = null;
              resetSlotsDisplay();
              updateMainUI();
            }
          });

          $('#btnFullscreen').on('click', function () {
            if (!document.fullscreenElement) document.documentElement.requestFullscreen();
            else document.exitFullscreen();
          });

          $('#soundToggleBtn').on('click', function () {
            soundEnabled = !soundEnabled;
            $(this).html(soundEnabled
              ? '<i class="fa-solid fa-volume-high"></i> Âm thanh: Bật'
              : '<i class="fa-solid fa-volume-xmark"></i> Âm thanh: Tắt');
          });

          const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
          function playTickSound() {
            if (!soundEnabled) return;
            const osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
            osc.type = 'triangle'; osc.frequency.setValueAtTime(520, audioCtx.currentTime);
            gain.gain.setValueAtTime(0.05, audioCtx.currentTime); gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.04);
            osc.connect(gain); gain.connect(audioCtx.destination); osc.start(); osc.stop(audioCtx.currentTime + 0.04);
          }
          function playLockSound() {
            if (!soundEnabled) return;
            const osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
            osc.type = 'sine'; osc.frequency.setValueAtTime(880, audioCtx.currentTime);
            gain.gain.setValueAtTime(0.12, audioCtx.currentTime); gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.15);
            osc.connect(gain); gain.connect(audioCtx.destination); osc.start(); osc.stop(audioCtx.currentTime + 0.15);
          }
          function playWinSound() {
            if (!soundEnabled) return;
            [523.25, 659.25, 783.99, 1046.50].forEach((freq, i) => {
              const osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
              osc.type = 'triangle'; osc.frequency.setValueAtTime(freq, audioCtx.currentTime + i * 0.12);
              gain.gain.setValueAtTime(0.15, audioCtx.currentTime + i * 0.12); gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + i * 0.12 + 0.4);
              osc.connect(gain); gain.connect(audioCtx.destination); osc.start(audioCtx.currentTime + i * 0.12); osc.stop(audioCtx.currentTime + i * 0.12 + 0.4);
            });
          }
          function launchConfetti() {
            confetti({ particleCount: 120, spread: 80, origin: { y: 0.6 }, colors: ['#ffd666', '#ff4d4f', '#ffffff', '#faad14'] });
          }

          // Khởi chạy ban đầu
          loadDataFromDotNetApi();
        });
    </script>
</body>
</html>