@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quay Số Trúng Thưởng - Sự Kiện</title>

    <!-- Bootstrap 5 & FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@600;700&family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <!-- jQuery 3.7 & Canvas Confetti -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <style>
        :root {
          --bg-crimson-dark: #4a0404;
          --bg-crimson-main: #8b0000;
          --bg-crimson-light: #b30000;
          --gold-light: #fff3b0;
          --gold-main: #f4c430;
          --gold-dark: #c58b00;
          --glass-bg: rgba(65, 5, 5, 0.72);
          --glass-border: rgba(244, 196, 48, 0.35);
        }

        * { box-sizing: border-box; user-select: none; }

        body {
            margin: 0;
            padding: 64px 0 0 0 !important;
            min-height: 100vh;
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: #fff;
            background: radial-gradient(circle at 50% 35%, var(--bg-crimson-light) 0%, var(--bg-crimson-main) 45%, var(--bg-crimson-dark) 100%);
            overflow-x: hidden;
            overflow-y: auto;
            position: relative;
        }

        /* Họa tiết trang trí nền chính */
        .decor-cloud-left, .decor-cloud-right {
          position: fixed; top: 48px; width: 280px; height: 140px; pointer-events: none; z-index: 1; opacity: 0.9;
        }
        .decor-cloud-left { left: -10px; }
        .decor-cloud-right { right: -10px; transform: scaleX(-1); }

        .decor-bottom-left, .decor-bottom-right {
          position: fixed; bottom: -15px; width: 320px; height: 320px; pointer-events: none; z-index: 1; opacity: 0.85;
        }
        .decor-bottom-left { left: -20px; }
        .decor-bottom-right { right: -20px; transform: scaleX(-1); }

        /* Navbar */
        .top-navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 64px;
            background: rgba(38, 2, 2, 0.94);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(244, 196, 48, 0.25);
            padding: 0 28px;
            z-index: 1030;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.5);
        }

        .brand-logo {
            display: inline-flex;
            align-items: center;
            gap: 16px;
            text-decoration: none;
        }

        .lotes-svg-logo {
            height: 30px;
            width: auto;
            display: block;
            filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.4));
        }

        .brand-system-title {
            color: #f3d299;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            font-size: 1.05rem;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            line-height: 1;
            white-space: nowrap;
        }

        .logo-badge {
          background: linear-gradient(135deg, #ffe066, #d48806);
          color: #5c0000;
          font-family: 'Oswald', sans-serif;
          font-weight: 700;
          padding: 4px 8px;
          border-radius: 6px;
          font-size: 1.1rem;
          box-shadow: 0 2px 8px rgba(0,0,0,0.4);
        }
        .brand-text { color: var(--gold-light); font-weight: 800; letter-spacing: 0.5px; font-size: 1.05rem; line-height: 1.1; }
        .brand-sub { font-size: 0.65rem; color: #f8d7da; display: block; font-weight: 400; }

        /* Khu vực quay số trung tâm */
        .main-container {
          position: relative; z-index: 5; max-width: 1140px; margin: 0 auto; padding: 20px 15px 60px; text-align: center;
        }
        .event-title {
          font-family: 'Oswald', sans-serif;
          font-size: clamp(2.2rem, 4.5vw, 3.6rem);
          font-weight: 700;
          text-transform: uppercase;
          letter-spacing: 1.5px;
          background: linear-gradient(180deg, #fffbe6 0%, #ffd666 45%, #d48806 100%);
          -webkit-background-clip: text;
          -webkit-text-fill-color: transparent;
          filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.55));
          margin-bottom: 5px;
        }
        .prize-selector { display: inline-flex; align-items: center; justify-content: center; gap: 18px; margin-bottom: 10px; }
        .prize-nav-btn {
          background: transparent; border: none; color: rgba(255, 243, 176, 0.6); font-size: 1.4rem; cursor: pointer; transition: 0.2s;
        }
        .prize-nav-btn:hover { color: var(--gold-main); transform: scale(1.2); }
        .current-prize-name {
          font-family: 'Oswald', sans-serif; font-size: clamp(1.5rem, 2.8vw, 2.2rem); font-weight: 700; color: #fff;
          text-shadow: 0 3px 10px rgba(0,0,0,0.6); letter-spacing: 1px; min-width: 240px;
        }
        .prize-medal {
          width: 46px; height: 46px; margin: 0 auto 18px;
          background: linear-gradient(135deg, #fff1b8, #faad14, #ad6800);
          clip-path: polygon(50% 0%, 95% 25%, 95% 75%, 50% 100%, 5% 75%, 5% 25%);
          display: flex; align-items: center; justify-content: center;
          color: #610b00; font-weight: 800; font-size: 1.25rem;
          box-shadow: 0 4px 15px rgba(250, 173, 20, 0.5);
        }

        /* 8 Ô Quay Số (Khớp mã VN000032) */
        .slot-machine-wrapper {
          display: flex; justify-content: center; gap: clamp(6px, 1.2vw, 14px); margin: 10px auto 28px; padding: 12px;
        }
        .slot-box {
          width: clamp(42px, 9.5vw, 84px);
          height: clamp(58px, 11.5vw, 105px);
          background: linear-gradient(180deg, rgba(168, 7, 26, 0.85) 0%, rgba(110, 4, 15, 0.92) 100%);
          border: 2px solid rgba(255, 255, 255, 0.65);
          border-radius: 14px;
          display: flex; align-items: center; justify-content: center;
          font-family: 'Oswald', sans-serif;
          font-size: clamp(1.8rem, 4vw, 3.4rem);
          font-weight: 700; color: #ffffff;
          box-shadow: 0 0 25px rgba(255, 214, 102, 0.35), inset 0 0 15px rgba(0, 0, 0, 0.45);
          transition: transform 0.15s ease, border-color 0.3s ease, box-shadow 0.3s ease;
        }
        .slot-box.spinning { border-color: var(--gold-main); box-shadow: 0 0 30px rgba(244, 196, 48, 0.8); color: var(--gold-light); }
        .slot-box.locked { border-color: #fff; background: linear-gradient(180deg, #cf1322 0%, #820014 100%); transform: scale(1.03); }

        /* Nút Quay Số */
        .btn-spin-action {
          background: linear-gradient(180deg, #ffe58f 0%, #f4c430 50%, #d48806 100%);
          color: #4a0404; border: 2px solid #fffbe6; border-radius: 50px; padding: 12px 48px;
          font-size: 1.15rem; font-weight: 800; letter-spacing: 1px; text-transform: uppercase;
          box-shadow: 0 6px 20px rgba(0, 0, 0, 0.45), 0 0 15px rgba(244, 196, 48, 0.5);
          cursor: pointer; transition: all 0.2s ease;
        }
        .btn-spin-action:hover:not(:disabled) { transform: translateY(-2px) scale(1.03); box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5), 0 0 25px rgba(255, 229, 143, 0.8); }
        .btn-spin-action:disabled { opacity: 0.6; cursor: not-allowed; }
        .spin-counter-text { margin-top: 12px; font-size: 0.85rem; color: rgba(255, 255, 255, 0.85); }

        /* Thanh công cụ giữa */
        .control-toolbar { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin: 26px auto 18px; }
        .tool-btn {
          background: rgba(55, 4, 4, 0.6); border: 1px solid rgba(244, 196, 48, 0.3); color: #fff3b0;
          padding: 6px 14px; border-radius: 8px; font-size: 0.85rem; font-weight: 600;
          display: inline-flex; align-items: center; gap: 6px; cursor: pointer; transition: 0.2s;
        }
        .tool-btn:hover { background: rgba(244, 196, 48, 0.2); border-color: var(--gold-main); color: #fff; }

        /* Bảng danh sách trúng giải dưới màn hình chính */
        .winners-board {
          max-width: 820px; margin: 0 auto; background: var(--glass-bg); backdrop-filter: blur(10px);
          border: 1px solid var(--glass-border); border-radius: 14px; padding: 18px 22px;
          box-shadow: 0 12px 35px rgba(0, 0, 0, 0.45); text-align: left;
        }
        .board-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
        .board-title { font-size: 1.05rem; font-weight: 700; color: #fff; margin: 0; }
        .btn-export {
          background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.25); color: #fff;
          font-size: 0.8rem; padding: 5px 12px; border-radius: 6px; cursor: pointer; transition: 0.2s;
        }
        .btn-export:hover { background: var(--gold-main); color: #4a0404; font-weight: 700; }

        .prize-tabs { display: flex; flex-wrap: wrap; gap: 16px; border-bottom: 1px solid rgba(255, 255, 255, 0.15); padding-bottom: 8px; margin-bottom: 14px; }
        .prize-tab-item {
          background: none; border: none; color: rgba(255, 255, 255, 0.65); font-size: 0.88rem; font-weight: 600;
          padding: 4px 2px; cursor: pointer; position: relative; transition: 0.2s;
        }
        .prize-tab-item:hover { color: #fff; }
        .prize-tab-item.active { color: var(--gold-main); }
        .prize-tab-item.active::after { content: ''; position: absolute; bottom: -9px; left: 0; width: 100%; height: 2px; background: var(--gold-main); }

        .custom-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
        .custom-table th { background: rgba(255, 255, 255, 0.06); color: var(--gold-light); font-weight: 700; padding: 10px 12px; text-align: center; border-bottom: 1px solid rgba(255, 255, 255, 0.15); }
        .custom-table td { padding: 12px; text-align: center; border-bottom: 1px solid rgba(255, 255, 255, 0.08); color: #fff; }
        .custom-table tbody tr:hover { background: rgba(255, 255, 255, 0.05); }

        .btn-fullscreen-float {
          position: fixed; bottom: 18px; left: 18px; z-index: 20; width: 40px; height: 40px; border-radius: 8px;
          background: rgba(45, 2, 2, 0.8); border: 1px solid var(--gold-main); color: var(--gold-main);
          display: flex; align-items: center; justify-content: center; cursor: pointer;
        }

        /* ================= DARK PURPLE MODALS (Danh sách quay số & Kết quả tổng) ================= */
        .dark-modal-content {
          background: #1c162d; border: 1px solid rgba(139, 92, 246, 0.35); border-radius: 16px;
          color: #f8fafc; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
        }
        .dark-modal-header { border-bottom: none; padding: 22px 26px 10px; }
        .plan-limit-bar {
          background: #251e3a; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 10px;
          padding: 10px 16px; margin-bottom: 16px; font-size: 0.88rem;
        }
        .badge-free { background: rgba(139, 92, 246, 0.25); color: #c4b5fd; padding: 3px 8px; border-radius: 6px; font-size: 0.75rem; }
        .badge-slots { background: rgba(16, 185, 129, 0.18); color: #34d399; padding: 3px 10px; border-radius: 6px; font-size: 0.78rem; font-weight: 600; }
        .search-input-dark {
          background: #251e3a !important; border: 1px solid rgba(255, 255, 255, 0.1) !important;
          color: #fff !important; border-radius: 8px; padding-left: 36px;
        }
        .search-input-dark::placeholder { color: #94a3b8; }
        .btn-purple-grad { background: linear-gradient(135deg, #7c3aed, #6d28d9); border: none; color: #fff; font-weight: 600; border-radius: 8px; padding: 7px 14px; }
        .btn-cyan-grad { background: linear-gradient(135deg, #06b6d4, #6366f1); border: none; color: #fff; font-weight: 600; border-radius: 8px; padding: 7px 14px; }
        .btn-dark-outline { background: #251e3a; border: 1px solid rgba(255, 255, 255, 0.12); color: #e2e8f0; border-radius: 8px; padding: 7px 14px; }

        .participants-table-wrap { background: #231c36; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.07); overflow: hidden; }
        .participants-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
        .participants-table th { background: #2b2342; color: #cbd5e1; font-weight: 700; text-transform: uppercase; font-size: 0.78rem; padding: 13px 16px; text-align: left; }
        .participants-table td { padding: 12px 16px; border-top: 1px solid rgba(255, 255, 255, 0.06); color: #f1f5f9; }
        .participants-table tr:hover td { background: rgba(139, 92, 246, 0.08); }

        .action-icon-btn {
          width: 30px; height: 30px; border-radius: 50%; background: rgba(255, 255, 255, 0.06); border: none;
          color: #cbd5e1; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; transition: 0.2s;
        }
        .action-icon-btn:hover { background: #7c3aed; color: #fff; }
        .action-icon-btn.delete:hover { background: #ef4444; color: #fff; }
        .page-btn { background: transparent; border: none; color: #94a3b8; width: 30px; height: 30px; border-radius: 6px; font-size: 0.85rem; }
        .page-btn.active { background: #8b5cf6; color: #fff; font-weight: 700; }

        /* Modal Kết quả tổng */
        .result-modal-header {
          background: linear-gradient(135deg, #2d1b4e 0%, #1c162d 100%);
          border-bottom: 1px solid rgba(255, 255, 255, 0.08);
          padding: 22px 28px 14px; border-top-left-radius: 16px; border-top-right-radius: 16px;
        }
        .result-tabs-bar { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding: 0 28px; background: #1c162d; }
        .result-tab-btn { background: none; border: none; color: #94a3b8; font-weight: 600; font-size: 0.92rem; padding: 14px 4px; margin-right: 24px; position: relative; cursor: pointer; transition: 0.2s; }
        .result-tab-btn:hover { color: #e2e8f0; }
        .result-tab-btn.active { color: #ffffff; }
        .result-tab-btn.active::after { content: ''; position: absolute; bottom: -1px; left: 0; width: 100%; height: 3px; background: linear-gradient(90deg, #8b5cf6, #06b6d4); border-radius: 3px 3px 0 0; }

        .stt-badge-purple { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; background: rgba(139, 92, 246, 0.2); color: #c4b5fd; border-radius: 6px; font-weight: 700; font-size: 0.8rem; }
        .code-pill-gold { display: inline-block; background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.45); color: #fbbf24; font-weight: 700; font-size: 0.8rem; padding: 3px 10px; border-radius: 6px; letter-spacing: 0.5px; }
        .prize-pill-cyan { display: inline-flex; align-items: center; gap: 6px; background: rgba(6, 182, 212, 0.16); border: 1px solid rgba(6, 182, 212, 0.4); color: #67e8f9; font-weight: 600; font-size: 0.8rem; padding: 4px 12px; border-radius: 8px; }
        .btn-reset-danger-outline { background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.35); color: #f87171; font-weight: 600; border-radius: 10px; padding: 9px 18px; transition: 0.2s; }
        .btn-reset-danger-outline:hover { background: rgba(239, 68, 68, 0.25); color: #fca5a5; }
        .btn-download-gold { background: linear-gradient(135deg, #f59e0b, #fbbf24); border: none; color: #1e1b2e; font-weight: 700; border-radius: 10px; padding: 9px 20px; box-shadow: 0 4px 15px rgba(245, 158, 11, 0.35); transition: 0.2s; }

        /* ================= MÀN HÌNH VINH DANH FULLSCREEN (Kết quả vừa quay) ================= */
        .winner-celebration-overlay {
          position: fixed; inset: 0; z-index: 9999;
          background: radial-gradient(circle at 50% 45%, #a8071a 0%, #7a000d 55%, #4a0005 100%);
          display: none; flex-direction: column; align-items: center; justify-content: center;
          text-align: center; padding: 20px; overflow: hidden; animation: fadeInOverlay 0.35s ease-out;
        }
        .winner-celebration-overlay.show { display: flex; }
        @@keyframes fadeInOverlay { from { opacity: 0; transform: scale(1.03); } to { opacity: 1; transform: scale(1); } }

        .celeb-cloud-left, .celeb-cloud-right { position: absolute; top: 0; width: clamp(220px, 28vw, 380px); pointer-events: none; z-index: 1; }
        .celeb-cloud-left { left: 0; }
        .celeb-cloud-right { right: 0; transform: scaleX(-1); }
        .celeb-bottom-left, .celeb-bottom-right { position: absolute; bottom: 0; width: clamp(240px, 30vw, 400px); pointer-events: none; z-index: 1; }
        .celeb-bottom-left { left: 0; }
        .celeb-bottom-right { right: 0; transform: scaleX(-1); }

        .celeb-content { position: relative; z-index: 5; max-width: 850px; width: 100%; }
        .celeb-subtitle-top { font-size: clamp(1.3rem, 2.5vw, 1.9rem); font-weight: 700; color: #fff3b0; letter-spacing: 2px; margin-bottom: 8px; text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5); }
        .celeb-winner-code {
          font-family: 'Oswald', sans-serif; font-size: clamp(4rem, 9vw, 6.8rem); font-weight: 700; line-height: 1.05; letter-spacing: 4px;
          background: linear-gradient(180deg, #fffbe6 0%, #ffd666 55%, #d48806 100%);
          -webkit-background-clip: text; -webkit-text-fill-color: transparent;
          filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.55)); margin-bottom: 14px;
        }
        .celeb-winner-name { font-size: clamp(2rem, 4.5vw, 3.3rem); font-weight: 800; color: #ffffff; text-shadow: 0 4px 12px rgba(0, 0, 0, 0.55); margin-bottom: 6px; }
        .celeb-winner-dept { font-size: clamp(1rem, 2vw, 1.35rem); font-weight: 500; color: rgba(255, 255, 255, 0.9); margin-bottom: 18px; }
        .celeb-won-label { font-size: 0.85rem; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: rgba(255, 243, 176, 0.85); margin-bottom: 4px; }
        .celeb-prize-name { font-size: clamp(1.7rem, 3.5vw, 2.6rem); font-weight: 800; color: #ffd666; text-shadow: 0 3px 10px rgba(0, 0, 0, 0.55); margin-bottom: 36px; }
        .btn-celeb-close {
          background: linear-gradient(180deg, #ffe58f 0%, #f4c430 60%, #d48806 100%);
          color: #4a0404; border: 1px solid #fffbe6; border-radius: 8px; padding: 10px 42px;
          font-size: 0.95rem; font-weight: 800; letter-spacing: 1px; text-transform: uppercase;
          box-shadow: 0 6px 20px rgba(0, 0, 0, 0.45); cursor: pointer; transition: 0.2s;
        }
        .btn-celeb-close:hover { transform: translateY(-2px) scale(1.04); box-shadow: 0 8px 25px rgba(244, 196, 48, 0.6); }
    </style>
</head>
<body>

    <!-- Họa tiết SVG nền -->
    <svg class="decor-cloud-left" viewBox="0 0 300 150" fill="none">
        <path d="M-20 0 H240 C260 35 230 75 190 65 C180 95 130 105 105 80 C85 110 30 110 15 75 C-10 85 -30 50 -20 0 Z" fill="#6b0000" stroke="#e6b800" stroke-width="3" />
        <path d="M10 20 C40 20 50 50 30 65 C15 75 0 60 10 45 C18 35 30 42 25 52" stroke="#f4c430" stroke-width="3" stroke-linecap="round" />
        <path d="M90 15 C120 15 135 45 115 65 C95 80 75 60 90 42" stroke="#f4c430" stroke-width="3" stroke-linecap="round" />
    </svg>
    <svg class="decor-cloud-right" viewBox="0 0 300 150" fill="none">
        <path d="M-20 0 H240 C260 35 230 75 190 65 C180 95 130 105 105 80 C85 110 30 110 15 75 C-10 85 -30 50 -20 0 Z" fill="#6b0000" stroke="#e6b800" stroke-width="3" />
        <path d="M10 20 C40 20 50 50 30 65 C15 75 0 60 10 45 C18 35 30 42 25 52" stroke="#f4c430" stroke-width="3" stroke-linecap="round" />
        <path d="M90 15 C120 15 135 45 115 65 C95 80 75 60 90 42" stroke="#f4c430" stroke-width="3" stroke-linecap="round" />
    </svg>
    <svg class="decor-bottom-left" viewBox="0 0 300 300" fill="none">
        <circle cx="40" cy="270" r="160" fill="#a8071a" stroke="#f4c430" stroke-width="4" stroke-dasharray="12 6" />
        <circle cx="40" cy="270" r="130" fill="#cf1322" stroke="#ffe58f" stroke-width="2" />
        <path d="M40 270 L180 190 A160 160 0 0 1 200 270 Z" fill="#f4c430" opacity="0.85" />
        <path d="M40 270 L130 130 A160 160 0 0 1 180 190 Z" fill="#ff4d4f" opacity="0.9" />
    </svg>
    <svg class="decor-bottom-right" viewBox="0 0 300 300" fill="none">
        <circle cx="40" cy="270" r="160" fill="#a8071a" stroke="#f4c430" stroke-width="4" stroke-dasharray="12 6" />
        <circle cx="40" cy="270" r="130" fill="#cf1322" stroke="#ffe58f" stroke-width="2" />
        <path d="M40 270 L180 190 A160 160 0 0 1 200 270 Z" fill="#f4c430" opacity="0.85" />
        <path d="M40 270 L130 130 A160 160 0 0 1 180 190 Z" fill="#ff4d4f" opacity="0.9" />
    </svg>

    <!-- Navbar -->
    <!-- Navbar cố định trên cùng -->
    <nav class="top-navbar d-flex justify-content-between align-items-center">
        <a href="/" class="brand-logo">
            <!-- Logo Vector LOTES sắc nét -->
            <svg class="lotes-svg-logo" viewBox="0 0 235 46" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Chữ L -->
                <path d="M2 4H12V34H34V42H4C2.89543 42 2 41.1046 2 40V4Z" fill="#E62E2D" />
                <!-- Chữ O -->
                <path fill-rule="evenodd" clip-rule="evenodd" d="M48 4H78C81.3137 4 84 6.68629 84 10V36C84 39.3137 81.3137 42 78 42H48C44.6863 42 42 39.3137 42 36V10C42 6.68629 44.6863 4 48 4ZM52 12V34H74V12H52Z" fill="#E62E2D" />
                <!-- Chữ T -->
                <path d="M90 4H132V12H116V42H106V12H90V4Z" fill="#E62E2D" />
                <!-- Chữ E -->
                <path d="M140 4H178V12H150V19H173V27H150V34H178V42H140V4Z" fill="#E62E2D" />
